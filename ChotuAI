package com.soikot.chotuai

import android.content.Intent
import android.os.Bundle
import android.view.animation.AnimationUtils
import android.widget.EditText
import android.widget.ImageButton
import android.widget.TextView
import android.widget.Toast
import androidx.appcompat.app.AppCompatActivity
import androidx.lifecycle.lifecycleScope
import androidx.recyclerview.widget.LinearLayoutManager
import androidx.recyclerview.widget.RecyclerView
import com.soikot.chotuai.ai.CommandParser
import com.soikot.chotuai.ai.CommandResult
import com.soikot.chotuai.ai.GeminiClient
import com.soikot.chotuai.ai.MemoryManager
import com.soikot.chotuai.ai.VoiceManager
import com.soikot.chotuai.util.SecurePrefs
import kotlinx.coroutines.launch

class MainActivity : AppCompatActivity() {

    private lateinit var recycler: RecyclerView
    private lateinit var adapter: MessageAdapter
    private lateinit var inputField: EditText
    private lateinit var btnSend: ImageButton
    private lateinit var btnMic: ImageButton
    private lateinit var btnSettings: ImageButton
    private lateinit var btnCode: ImageButton
    private lateinit var statusText: TextView
    private lateinit var orbView: android.view.View

    private lateinit var voice: VoiceManager
    private lateinit var gemini: GeminiClient

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_main)

        recycler = findViewById(R.id.chatRecycler)
        inputField = findViewById(R.id.inputField)
        btnSend = findViewById(R.id.btnSend)
        btnMic = findViewById(R.id.btnMic)
        btnSettings = findViewById(R.id.btnSettings)
        btnCode = findViewById(R.id.btnCode)
        statusText = findViewById(R.id.statusText)
        orbView = findViewById(R.id.orbView)

        adapter = MessageAdapter(MemoryManager.getHistory(this).map { Message(it.first, it.second) }.toMutableList())
        recycler.layoutManager = LinearLayoutManager(this)
        recycler.adapter = adapter

        voice = VoiceManager(this)
        gemini = GeminiClient(this)

        setupVoice()
        setupButtons()

        if (SecurePrefs.getApiKey(this).isNullOrEmpty()) {
            Toast.makeText(this, "Settings e giye Gemini API key dao boss 🔑", Toast.LENGTH_LONG).show()
        }
    }

    private fun setupVoice() {
        voice.onResult = { text ->
            inputField.setText(text)
            sendMessage(text)
        }
        voice.onError = { err ->
            statusText.text = "Error"
            Toast.makeText(this, err, Toast.LENGTH_SHORT).show()
        }
        voice.onReadyForSpeech = {
            statusText.text = "Listening..."
        }
    }

    private fun setupButtons() {
        btnSend.setOnClickListener {
            val text = inputField.text.toString().trim()
            if (text.isNotEmpty()) {
                inputField.setText("")
                sendMessage(text)
            }
        }

        btnMic.setOnClickListener {
            statusText.text = "Listening..."
            voice.startListening()
        }

        btnSettings.setOnClickListener {
            startActivity(Intent(this, SettingsActivity::class.java))
        }

        btnCode.setOnClickListener {
            startActivity(Intent(this, CodingStudioActivity::class.java))
        }

        // Orb pulse animation
        val pulse = AnimationUtils.loadAnimation(this, android.R.anim.fade_in)
        orbView.startAnimation(pulse)
    }

    private fun sendMessage(text: String) {
        adapter.addMessage(Message("user", text))
        MemoryManager.saveMessage(this, "user", text)
        recycler.scrollToPosition(adapter.itemCount - 1)

        // Check local commands first
        when (val cmd = CommandParser.parse(this, text)) {
            is CommandResult.Handled -> {
                adapter.addMessage(Message("model", cmd.response))
                MemoryManager.saveMessage(this, "model", cmd.response)
                voice.speak(cmd.response)
                recycler.scrollToPosition(adapter.itemCount - 1)
            }
            CommandResult.NotHandled -> {
                if (SecurePrefs.getApiKey(this).isNullOrEmpty()) {
                    val msg = "Boss, API key set koro age! Settings e giye Gemini API key paste kor 🔑"
                    adapter.addMessage(Message("model", msg))
                    MemoryManager.saveMessage(this, "model", msg)
                    voice.speak(msg)
                    return
                }
                statusText.text = "Thinking..."
                lifecycleScope.launch {
                    val result = gemini.chat(text, MemoryManager.getHistory(this@MainActivity).dropLast(1))
                    result.fold(
                        onSuccess = { reply ->
                            statusText.text = "Ready"
                            adapter.addMessage(Message("model", reply))
                            MemoryManager.saveMessage(this@MainActivity, "model", reply)
                            voice.speak(reply)
                            recycler.scrollToPosition(adapter.itemCount - 1)
                        },
                        onFailure = { e ->
                            statusText.text = "Error"
                            val msg = "Sorry boss, error hoise: ${e.message}"
                            adapter.addMessage(Message("model", msg))
                            recycler.scrollToPosition(adapter.itemCount - 1)
                        }
                    )
                }
            }
        }
    }

    override fun onDestroy() {
        super.onDestroy()
        voice.shutdown()
    }
}
