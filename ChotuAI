package com.soikot.chotuai.util

import android.content.Context
import android.content.Intent
import android.content.pm.PackageManager
import android.net.Uri

object AppLauncher {
    fun openApp(context: Context, packageName: String): Boolean {
        return try {
            val intent = context.packageManager.getLaunchIntentForPackage(packageName)
            if (intent != null) {
                intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
                context.startActivity(intent)
                true
            } else false
        } catch (e: Exception) { false }
    }

    fun openUrl(context: Context, url: String) {
        try {
            val intent = Intent(Intent.ACTION_VIEW, Uri.parse(url))
            intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
            context.startActivity(intent)
        } catch (e: Exception) { e.printStackTrace() }
    }

    fun searchGoogle(context: Context, query: String) {
        openUrl(context, "https://www.google.com/search?q=" + Uri.encode(query))
    }

    fun searchYouTube(context: Context, query: String) {
        val appIntent = Intent(Intent.ACTION_SEARCH)
        appIntent.setPackage("com.google.android.youtube")
        appIntent.putExtra("query", query)
        appIntent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
        try {
            context.startActivity(appIntent)
        } catch (e: Exception) {
            openUrl(context, "https://www.youtube.com/results?search_query=" + Uri.encode(query))
        }
    }

    fun getInstalledApps(context: Context): List<String> {
        val pm = context.packageManager
        val intents = pm.getInstalledApplications(PackageManager.GET_META_DATA)
        return intents.map { it.packageName }
    }
}
