package com.soikot.chotuai.ai

import android.content.Context
import org.json.JSONArray
import org.json.JSONObject

object MemoryManager {
    private const val PREFS = "chotu_memory"
    private const val KEY_HISTORY = "history"
    private const val KEY_FACTS = "facts"

    private fun prefs(context: Context) =
        context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)

    fun saveMessage(context: Context, role: String, text: String) {
        val arr = JSONArray(getHistory(context))
        arr.put(JSONObject().apply {
            put("role", role)
            put("text", text)
            put("time", System.currentTimeMillis())
        })
        // Keep last 50
        while (arr.length() > 100) arr.remove(0)
        prefs(context).edit().putString(KEY_HISTORY, arr.toString()).apply()
    }

    fun getHistory(context: Context): List<Pair<String, String>> {
        val raw = prefs(context).getString(KEY_HISTORY, "[]") ?: "[]"
        val arr = JSONArray(raw)
        val list = mutableListOf<Pair<String, String>>()
        for (i in 0 until arr.length()) {
            val o = arr.getJSONObject(i)
            list.add(o.getString("role") to o.getString("text"))
        }
        return list
    }

    fun clearHistory(context: Context) {
        prefs(context).edit().remove(KEY_HISTORY).apply()
    }
}
