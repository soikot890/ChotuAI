            SecurePrefs.saveApiKey(this, etKey.text.toString().trim())
            SecurePrefs.saveSetting(this, "model", spinner.selectedItem.toString())
            SecurePrefs.saveSetting(this, "temperature", (seekTemp.progress / 100f).toString())
            Toast.makeText(this, "✅ Saved boss!", Toast.LENGTH_SHORT).show()
            finish()
        }

        btnTest.setOnClickListener {
            SecurePrefs.saveApiKey(this, etKey.text.toString().trim())
            SecurePrefs.saveSetting(this, "model", spinner.selectedItem.toString())
            btnTest.isEnabled = false
            btnTest.text = "Testing..."
            lifecycleScope.launch {
                val r = GeminiClient(this@SettingsActivity).testConnection()
                btnTest.isEnabled = true
                btnTest.text = "Test Connection"
                r.fold(
                    onSuccess = { Toast.makeText(this@SettingsActivity, it, Toast.LENGTH_LONG).show() },
                    onFailure = { Toast.makeText(this@SettingsActivity, "❌ ${it.message}", Toast.LENGTH_LONG).show() }
                )
            }
        }
    }
}
