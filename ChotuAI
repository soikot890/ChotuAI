package com.soikot.chotuai

import android.os.Bundle
import android.view.View
import android.webkit.WebView
import android.widget.Button
import android.widget.EditText
import android.widget.Toast
import androidx.appcompat.app.AppCompatActivity
import androidx.lifecycle.lifecycleScope
import com.soikot.chotuai.ai.GeminiClient
import com.soikot.chotuai.util.SecurePrefs
import kotlinx.coroutines.launch

class CodingStudioActivity : AppCompatActivity() {
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_coding)

        val etCode = findViewById<EditText>(R.id.etCode)
        val btnRun = findViewById<Button>(R.id.btnRun)
        val btnExplain = findViewById<Button>(R.id.btnExplain)
        val web = findViewById<WebView>(R.id.webPreview)
        web.settings.javaScriptEnabled = true

        btnRun.setOnClickListener {
            val code = etCode.text.toString()
            if (code.contains("<html", true) || code.contains("<body", true) || code.contains("<div", true)) {
                web.visibility = View.VISIBLE
                web.loadDataWithBaseURL(null, code, "text/html", "UTF-8", null)
            } else {
                Toast.makeText(this, "HTML code dao boss", Toast.LENGTH_SHORT).show()
            }
        }

        btnExplain.setOnClickListener {
            val code = etCode.text.toString()
            if (SecurePrefs.getApiKey(this).isNullOrEmpty()) {
                Toast.makeText(this, "API key set koro age", Toast.LENGTH_SHORT).show()
                return@setOnClickListener
            }
            btnExplain.isEnabled = false
            btnExplain.text = "Analyzing..."
            lifecycleScope.launch {
                val r = GeminiClient(this@CodingStudioActivity).chat(
                    "Explain this code simply:\n\n$code", emptyList()
                )
                btnExplain.isEnabled = true
                btnExplain.text = "Explain"
                r.fold(
                    onSuccess = { reply ->
                        etCode.setText("$code\n\n/* === EXPLANATION ===\n$reply\n*/")
                    },
                    onFailure = { Toast.makeText(this@CodingStudioActivity, it.message, Toast.LENGTH_LONG).show() }
                )
            }
        }
    }
}
