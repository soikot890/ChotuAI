package com.soikot.chotuai.ai

import android.content.Context
import com.soikot.chotuai.util.AppLauncher
import java.text.SimpleDateFormat
import java.util.*

sealed class CommandResult {
    data class Handled(val response: String) : CommandResult()
    object NotHandled : CommandResult()
}

object CommandParser {
    fun parse(context: Context, input: String): CommandResult {
        val lower = input.lowercase().trim()

        // Time
        if (lower.contains("time") || lower.contains("somoy") || lower.contains("সময়")) {
            val time = SimpleDateFormat("hh:mm a", Locale.getDefault()).format(Date())
            return CommandResult.Handled("Boss, ekhon somoy $time ⏰")
        }

        // Date
        if (lower.contains("date") || lower.contains("tarikh") || lower.contains("তারিখ")) {
            val date = SimpleDateFormat("EEEE, dd MMMM yyyy", Locale.getDefault()).format(Date())
            return CommandResult.Handled("Ajker tarikh: $date 📅")
        }

        // Open YouTube
        if (lower.contains("youtube") && (lower.contains("open") || lower.contains("kholo") || lower.contains("chalu"))) {
            AppLauncher.openApp(context, "com.google.android.youtube")
            return CommandResult.Handled("YouTube khule diyechi boss 🎬")
        }

        // Open Facebook
        if (lower.contains("facebook") && (lower.contains("open") || lower.contains("kholo"))) {
            AppLauncher.openApp(context, "com.facebook.katana")
            return CommandResult.Handled("Facebook khule diyechi 📘")
        }

        // Open Google
        if (lower.contains("google") && (lower.contains("open") || lower.contains("kholo"))) {
            AppLauncher.openUrl(context, "https://www.google.com")
            return CommandResult.Handled("Google khule diyechi 🔍")
        }

        // Search Google
        if (lower.contains("search") || lower.contains("khoj") || lower.contains("খোঁজ")) {
            val query = lower.replace(Regex("(chotu,?\\s*)?(search|khoj|khõj)\\s*(koro|kor|google e|google te)?\\s*"), "").trim()
            if (query.isNotEmpty()) {
                AppLauncher.searchGoogle(context, query)
                return CommandResult.Handled("Google e '$query' search korchi 🔎")
            }
        }

        // YouTube search
        if (lower.contains("youtube") && (lower.contains("search") || lower.contains("play"))) {
            val query = lower.replace(Regex("(chotu,?\\s*)?(youtube|play|search)\\s*(koro|e|te)?\\s*"), "").trim()
            if (query.isNotEmpty()) {
                AppLauncher.searchYouTube(context, query)
                return CommandResult.Handled("YouTube e '$query' khujchi 🎵")
            }
        }

        // Open settings
        if (lower.contains("settings") || lower.contains("setings")) {
            return CommandResult.Handled("Settings e jete chaile uporer gear icon e tap koro ⚙️")
        }

        return CommandResult.NotHandled
    }
}
